<Window x:Class="GotifyDesktop.AccountWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="账号验证" Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}">
 <StackPanel Margin="24">
  <TextBlock x:Name="Explanation" TextWrapping="Wrap" Margin="0,0,0,16"/>
  <TextBlock Text="服务器" Margin="0,0,0,5"/><TextBox x:Name="ServerBox" Margin="0,0,0,12"/>
  <TextBlock Text="用户名" Margin="0,0,0,5"/><TextBox x:Name="UserBox" Margin="0,0,0,12"/>
  <TextBlock Text="密码（仅用于本次验证，不保存）" Margin="0,0,0,5"/><PasswordBox x:Name="PasswordBox" Padding="10" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}"/>
  <TextBlock x:Name="ValidationLabel" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="取消" IsCancel="True" Margin="0,0,8,0"/><Button x:Name="ConfirmButton" Content="验证" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Confirm_Click"/></StackPanel>
 </StackPanel>
</Window>


