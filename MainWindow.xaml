<Window x:Class="GotifyDesktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GotifyDesktop" Title="Gotify Desktop" Height="840" Width="1180" MinHeight="660" MinWidth="960" Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Microsoft YaHei UI" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown">
 <Window.Resources><local:SmallIconConverter x:Key="SmallIcon"/></Window.Resources>
 <DockPanel Background="{DynamicResource PageBrush}">
  <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,18">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal"><Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="12" Padding="9" Margin="0,0,12,0"><Image Source="{Binding Source='pack://application:,,,/Assets/logo.png', Converter={StaticResource SmallIcon}}" Width="30" Height="30"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Gotify Desktop" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="ServerLabel" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border x:Name="ConnectionBadge" Background="{DynamicResource RaisedBrush}" CornerRadius="14" Padding="10,6" Margin="0,0,14,0" MinHeight="36" VerticalAlignment="Center" UseLayoutRounding="True"><Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource MutedBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock x:Name="StatusLabel" Grid.Column="1" Text="未连接" FontSize="11" LineHeight="16" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center"/></Grid></Border><Button x:Name="ThemeButton" Content="深色模式" Click="Theme_Click" Margin="0,0,8,0"/><Button x:Name="ManagementButton" Content="管理" Click="Management_Click" Margin="0,0,8,0"/><Button Content="设置" Click="Settings_Click"/></StackPanel>
   </Grid>
  </Border>
  <Border DockPanel.Dock="Bottom" Padding="24,12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"><DockPanel LastChildFill="False"><TextBlock x:Name="CountLabel" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock x:Name="LastSyncLabel" Text="尚未同步" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></DockPanel></Border>
  <Grid x:Name="MainContentGrid" Margin="24,20,24,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="MainHeaderGrid" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="消息中心" FontSize="20" FontWeight="SemiBold"/><Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="9" Padding="8,3" Margin="10,1,0,0"><TextBlock x:Name="UnreadLabel" Text="0 未读" FontSize="11" Foreground="{DynamicResource AccentBrush}"/></Border></StackPanel>
     <Grid Margin="0,12,20,0"><TextBox x:Name="SearchBox" TextChanged="Search_Changed" Padding="12,9" AutomationProperties.Name="搜索标题、内容和应用名称"/><TextBlock Text="搜索标题、内容或应用名称  ·  Ctrl+F" Foreground="{DynamicResource MutedBrush}" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
    </StackPanel>
    <StackPanel Grid.Column="1"><Button x:Name="ComposeToggle" Content="＋ 撰写消息" Click="Compose_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Bottom"><CheckBox x:Name="UnreadOnlyBox" Content="只看未读" Checked="UnreadFilter_Changed" Unchecked="UnreadFilter_Changed" Margin="0,0,14,0"/><Button x:Name="RefreshButton" Content="刷新" Click="Refresh_Click"/><Button x:Name="OlderButton" Content="更早消息" Click="Older_Click" Margin="8,0,0,0"/><Button x:Name="MoreButton" Content="更多 ▾" Click="More_Click" Margin="8,0,0,0"><Button.ContextMenu><ContextMenu><MenuItem Header="全部标为已读" Click="MarkAllRead_Click"/><Separator Style="{StaticResource MenuSeparator}"/><MenuItem Header="清空本机记录…" Click="Clear_Click"/><Separator Style="{StaticResource MenuSeparator}"/><MenuItem Header="清空全部服务器消息…" Click="ClearServerMessages_Click"/></ContextMenu></Button.ContextMenu></Button></StackPanel></StackPanel>
    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
     <WrapPanel VerticalAlignment="Center">
      <TextBlock Text="应用" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0"/>
      <ComboBox x:Name="ApplicationFilter" Width="155" Margin="0,0,14,0" SelectionChanged="Filter_Changed" ToolTip="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="按应用筛选"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <TextBlock Text="时间" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0"/>
      <ComboBox x:Name="TimeFilter" Width="120" Margin="0,0,14,0" SelectedIndex="0" SelectionChanged="TimeFilter_Changed" AutomationProperties.Name="按时间筛选"><ComboBoxItem Content="全部时间"/><ComboBoxItem Content="今天"/><ComboBoxItem Content="最近 24 小时"/><ComboBoxItem Content="最近 7 天"/><ComboBoxItem Content="最近 30 天"/><ComboBoxItem Content="自定义"/></ComboBox>
      <StackPanel x:Name="CustomTimePanel" Visibility="Collapsed" Orientation="Horizontal" Margin="0,0,10,0">
       <TextBox x:Name="TimeFromBox" Width="144" TextChanged="CustomTime_Changed" ToolTip="开始时间，例如 2026-11-06 或 2026-11-06 09:30；留空不限" AutomationProperties.Name="开始时间"/>
       <TextBlock Text="至" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="6,0"/>
       <TextBox x:Name="TimeUntilBox" Width="144" TextChanged="CustomTime_Changed" ToolTip="结束时间，日期包含当天，时间包含该分钟；留空不限" AutomationProperties.Name="结束时间"/>
       <Button Content="应用" Click="ApplyTime_Click" Margin="8,0,0,0" Padding="10,6"/>
      </StackPanel>
      <Button Content="清除筛选" Click="ResetFilters_Click" Padding="10,6"/>
     </WrapPanel>
     <TextBlock x:Name="TimeFilterHint" Visibility="Collapsed" TextWrapping="Wrap" FontSize="11" Margin="0,7,0,0" Foreground="{DynamicResource MutedBrush}"/>
    </StackPanel>
   </Grid>
   <Border x:Name="NoticePanel" Grid.Row="1" Visibility="Collapsed" CornerRadius="9" Padding="14,11" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="NoticeHeading" Text="提示" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="NoticeLabel" TextWrapping="Wrap" FontSize="12" Margin="0,4,12,0"/></StackPanel><Button x:Name="NoticeActionButton" Grid.Column="1" Content="重试" Click="NoticeAction_Click" VerticalAlignment="Center" Margin="6,0,8,0"/><Button Grid.Column="2" Content="×" ToolTip="关闭提示" Click="DismissNotice_Click" Padding="9,4" VerticalAlignment="Top"/></Grid></Border>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" MinWidth="300"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*" MinWidth="310"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="4">
     <Grid>
      <ListView x:Name="MessagesList" ContextMenuOpening="MessageContext_Opening" SelectionChanged="Message_Selected" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionMode="Single" IsSynchronizedWithCurrentItem="False">
       <ListView.ContextMenu><ContextMenu><MenuItem Header="复制消息" Click="Copy_Click"/><MenuItem Header="标为未读" Click="MarkUnread_Click"/><Separator Style="{StaticResource MenuSeparator}"/><MenuItem x:Name="DeleteServerMenu" Header="删除此条服务器消息…" Click="DeleteServerMessage_Click"/></ContextMenu></ListView.ContextMenu>
       <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border x:Name="Row" CornerRadius="8" Background="{TemplateBinding Background}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource RaisedBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListView.ItemContainerStyle>
       <ListView.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid VerticalAlignment="Top"><Image Source="{Binding AppIconPath, Converter={StaticResource SmallIcon}}" Width="27" Height="27" HorizontalAlignment="Left"/><Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="23,-2,0,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsUnread}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse></Grid>
        <StackPanel Grid.Column="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Normal"/><Style.Triggers><DataTrigger Binding="{Binding IsUnread}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Border Grid.Column="1" CornerRadius="8" Padding="6,2"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource RaisedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsImportant}" Value="True"><Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Priority, StringFormat='优先级 {0}'}" FontSize="10"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsImportant}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></Grid>
         <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="19" MaxHeight="38" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,7,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding AppName}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,0,8,0"/><TextBlock Grid.Column="1" Text="{Binding Date, StringFormat={}{0:MM-dd HH:mm}}" Foreground="{DynamicResource MutedBrush}" FontSize="10"/></Grid>
         <Button x:Name="CopyListCodeButton" Content="复制验证码" Click="CopyListCode_Click" HorizontalAlignment="Left" Padding="10,4" MinHeight="28" FontSize="11" Margin="0,9,0,0" ToolTip="{Binding VerificationCode, StringFormat='仅复制验证码：{0}'}" AutomationProperties.Name="复制此条消息的验证码"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasVerificationCode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
        </StackPanel>
       </Grid></Border></DataTemplate></ListView.ItemTemplate>
      </ListView>
      <Border x:Name="EmptyPanel" Background="{DynamicResource SurfaceBrush}" CornerRadius="9" Visibility="Collapsed" Padding="24"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="270"><TextBlock Text="◎" FontSize="40" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/><TextBlock x:Name="EmptyTitle" Text="还没有消息" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="EmptyText" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,10,0,18"/><Button x:Name="EmptyActionButton" Content="刷新消息" Click="EmptyAction_Click" HorizontalAlignment="Center"/></StackPanel></Border>
     </Grid>
    </Border>
    <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Center" Background="Transparent" ToolTip="拖动调整列表与详情宽度"/>
    <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
     <Grid><StackPanel x:Name="DetailEmpty" VerticalAlignment="Center"><TextBlock Text="选择一条消息" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="在左侧选择消息，查看完整内容。" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,12,0,0"/></StackPanel>
      <Grid x:Name="DetailPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,0"><TextBlock Text="消息详情" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,12"/><TextBox Text="{Binding Title, Mode=OneWay}" IsReadOnly="True" IsUndoEnabled="False" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0" FontSize="20" FontWeight="SemiBold"/>
        <StackPanel Margin="0,14,0,18"><TextBlock Text="{Binding AppName}" FontSize="12"/><TextBlock Text="{Binding Date, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/><TextBlock Text="{Binding Priority, StringFormat='优先级 {0}'}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
        <Border x:Name="VerificationCard" Visibility="Collapsed" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="识别到的验证码" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="VerificationCodeBox" IsReadOnly="True" IsUndoEnabled="False" FontFamily="Consolas" FontSize="25" FontWeight="SemiBold" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,4,12,0" AutomationProperties.Name="识别到的验证码"/></StackPanel><Button x:Name="CopyCodeButton" Grid.Column="1" Content="复制验证码" Click="CopyCode_Click" Padding="10,6" VerticalAlignment="Center"/></Grid></Border>
        <WrapPanel Margin="0,0,0,12"><Button x:Name="OpenOriginalButton" Content="打开原页面" Click="OpenOriginal_Click" Visibility="Collapsed" Margin="0,0,8,4" Padding="10,6"/><CheckBox x:Name="ShowSourceBox" Content="原文" Checked="ShowSource_Changed" Unchecked="ShowSource_Changed" VerticalAlignment="Center" Margin="0,0,0,4"/></WrapPanel>
        <RichTextBox x:Name="DetailRichBody" IsReadOnly="True" IsUndoEnabled="False" Height="80" MaxHeight="360" IsDocumentEnabled="True" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" Padding="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MinHeight="80" AutomationProperties.Name="消息阅读视图"/>
        <TextBox x:Name="DetailBody" Visibility="Collapsed" Text="{Binding Message, Mode=OneWay}" IsReadOnly="True" IsUndoEnabled="False" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" Padding="0" FontSize="14" MinHeight="80" VerticalContentAlignment="Top" AutomationProperties.Name="完整消息内容"/>
       </StackPanel></ScrollViewer>
       <Grid Grid.Row="1" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="标为未读" Click="MarkUnread_Click" HorizontalAlignment="Left"/><Button Grid.Column="1" Content="复制完整消息" Click="Copy_Click"/></Grid>
      </Grid>
     </Grid>
    </Border>
   </Grid>
   <Border x:Name="ComposerPanel" Grid.Row="3" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,16,0,0">
    <ScrollViewer x:Name="ComposerScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Grid.ColumnSpan="3"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="撰写消息" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0"/><TextBlock Grid.Column="1" Text="发送应用" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="SendApplicationBox" Grid.Column="2" SelectionChanged="SendApplication_Changed" AutomationProperties.Name="选择发送应用" ToolTip="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource Self}}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button x:Name="RefreshSendAppsButton" Grid.Column="3" Content="刷新应用" Click="RefreshSendApplications_Click" Margin="8,0,12,0"/><Button Grid.Column="4" Content="收起，保留草稿" Click="Compose_Click" Padding="10,4"/></Grid>
     <TextBlock x:Name="SendApplicationHint" Grid.Row="1" Grid.ColumnSpan="3" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,12"/>
     <StackPanel Grid.Row="2"><TextBlock Text="标题" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="TitleBox" ToolTip="消息标题"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="优先级（0～10）" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="PriorityBox" Text="5"/></StackPanel><Button x:Name="SendButton" Grid.Row="2" Grid.Column="2" Content="发送消息" Click="Send_Click" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="12,0,0,0"/>
     <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,12,0,0"><TextBlock Text="消息内容  ·  Ctrl+Enter 发送" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="MessageContentBox" Height="75" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/></StackPanel>
    </Grid></ScrollViewer>
   </Border>
  </Grid>
 </DockPanel>
</Window>












