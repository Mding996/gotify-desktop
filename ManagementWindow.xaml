<Window x:Class="GotifyDesktop.ManagementWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Gotify 管理" Width="1120" Height="760" MinWidth="960" MinHeight="660" WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI" Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}">
 <Window.Resources>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Padding="20,12" CornerRadius="8,8,0,0" Background="{DynamicResource SurfaceBrush}" Margin="0,0,4,0"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ListViewItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="MinHeight" Value="44"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border x:Name="Row" Background="{TemplateBinding Background}" Padding="0,12" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"><GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource RaisedBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="GridViewColumnHeader"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Padding" Value="8,10"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridViewColumnHeader"><Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></Border></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <DockPanel Margin="22">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16"><TextBlock Text="Gotify 管理" FontSize="23" FontWeight="SemiBold"/><DockPanel Margin="0,12,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="LoginButton" Content="账号登录 / 切换账号" Click="Login_Click" Margin="0,0,8,0"/><Button x:Name="ReloadButton" Content="刷新" Click="Reload_Click"/></StackPanel><TextBlock x:Name="AccountLabel" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></DockPanel></StackPanel>
  <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" TextWrapping="Wrap" MinHeight="36" Margin="0,14,0,0" Foreground="{DynamicResource MutedBrush}"/>
  <TabControl x:Name="ManagementTabs" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" Foreground="{DynamicResource TextBrush}">
   <TabItem Header="应用">
    <Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
     <DockPanel Margin="0,0,18,0"><TextBlock DockPanel.Dock="Bottom" Text="选择应用后可编辑设置；删除应用也会删除该应用的服务器消息。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/><ListView x:Name="ApplicationsList" SelectionChanged="Application_Selected" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"><ListView.View><GridView><GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/><GridViewColumn Header="应用名称" DisplayMemberBinding="{Binding Name}" Width="190"/><GridViewColumn Header="描述" DisplayMemberBinding="{Binding Description}" Width="200"/><GridViewColumn Header="优先级" DisplayMemberBinding="{Binding DefaultPriority}" Width="70"/></GridView></ListView.View></ListView></DockPanel>
     <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="ApplicationEditorLabel" Text="新建应用" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="名称" Margin="0,14,0,5"/><TextBox x:Name="ApplicationName"/><TextBlock Text="描述" Margin="0,12,0,5"/><TextBox x:Name="ApplicationDescription" Height="68" AcceptsReturn="True" TextWrapping="Wrap"/><TextBlock Text="默认优先级（0～10）" Margin="0,12,0,5"/><TextBox x:Name="ApplicationPriority" Text="5"/><WrapPanel Margin="0,14,0,0"><Button Content="保存" Click="SaveApplication_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/><Button Content="新建" Click="NewApplication_Click" Margin="0,0,0,8"/></WrapPanel><WrapPanel><Button Content="上传图标" Click="UploadIcon_Click" Margin="0,0,8,8"/><Button Content="恢复默认图标" Click="RemoveIcon_Click" Margin="0,0,0,8"/></WrapPanel><WrapPanel><Button Content="查看本机 Token" Click="ApplicationToken_Click" Margin="0,0,8,8"/><Button Content="轮换 Token…" Click="RotateToken_Click" Margin="0,0,0,8"/></WrapPanel><Button Content="清空此应用的服务器消息…" Click="ClearApplication_Click" Margin="0,0,0,8"/><Button Content="删除应用…" Click="DeleteApplication_Click"/></StackPanel></ScrollViewer>
    </Grid>
   </TabItem>
   <TabItem Header="客户端">
    <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ListView x:Name="ClientsList" SelectionChanged="Client_Selected" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"><ListView.View><GridView><GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="45"/><GridViewColumn Header="客户端" DisplayMemberBinding="{Binding Name}" Width="185"/><GridViewColumn Header="创建时间" DisplayMemberBinding="{Binding CreatedDisplay}" Width="155"/><GridViewColumn Header="最近使用" DisplayMemberBinding="{Binding UsedDisplay}" Width="120"/><GridViewColumn Header="不活跃到期时间" DisplayMemberBinding="{Binding ExpiryDisplay}" Width="155"/><GridViewColumn Header="提权结束" DisplayMemberBinding="{Binding ElevationDisplay}" Width="100"/></GridView></ListView.View></ListView>
     <StackPanel Grid.Row="1" Margin="0,16,0,0"><WrapPanel><StackPanel Width="260" Margin="0,0,12,0"><TextBlock Text="客户端名称" Margin="0,0,0,5"/><TextBox x:Name="ClientName"/></StackPanel><StackPanel Width="220"><TextBlock Text="不活跃多少天后过期（0=永久）" Margin="0,0,0,5"/><TextBox x:Name="ClientDays" Text="0"/></StackPanel></WrapPanel><WrapPanel Margin="0,12,0,0"><Button Content="保存" Click="SaveClient_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/><Button Content="新建" Click="NewClient_Click" Margin="0,0,8,8"/><Button Content="查看本机 Token" Click="ClientToken_Click" Margin="0,0,8,8"/><Button Content="提权 15 分钟…" Click="Elevate_Click" Margin="0,0,8,8"/><Button Content="撤销客户端…" Click="DeleteClient_Click" Margin="0,0,8,8"/></WrapPanel><TextBlock Text="撤销后对应设备会断开连接。新客户端的 Token 会自动加密保存在本机；旧客户端的 Token 仅能查看本机已保存的副本。" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
    </Grid>
   </TabItem>
   <TabItem Header="Token 保险箱">
    <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="Token 使用 Windows DPAPI 加密，仅当前 Windows 账号可解密。这里只展示当前服务器在本机保存的记录。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
     <ListView x:Name="VaultList" Grid.Row="1" SelectionChanged="Vault_Selected" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"><ListView.View><GridView><GridViewColumn Header="名称" DisplayMemberBinding="{Binding Name}" Width="220"/><GridViewColumn Header="用途" DisplayMemberBinding="{Binding KindDisplay}" Width="120"/><GridViewColumn Header="账号 ID" DisplayMemberBinding="{Binding AccountId}" Width="70"/><GridViewColumn Header="对象 ID" DisplayMemberBinding="{Binding ObjectId}" Width="70"/><GridViewColumn Header="保存时间" DisplayMemberBinding="{Binding SavedDisplay}" Width="160"/><GridViewColumn Header="状态" DisplayMemberBinding="{Binding State}" Width="145"/></GridView></ListView.View></ListView>
     <StackPanel Grid.Row="2" Margin="0,14,0,0"><TextBox x:Name="TokenValue" Text="选择一条记录后点击显示或复制" IsReadOnly="True" TextWrapping="Wrap" MinHeight="45"/><WrapPanel Margin="0,10,0,0"><Button x:Name="RevealButton" Content="显示 Token" Click="Reveal_Click" Margin="0,0,8,8"/><Button Content="复制 Token" Click="CopyToken_Click" Margin="0,0,8,8"/><Button Content="用于当前连接 / 发送" Click="UseToken_Click" Margin="0,0,8,8"/><Button Content="删除本机副本…" Click="ForgetToken_Click" Margin="0,0,8,8"/></WrapPanel></StackPanel>
    </Grid>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>


